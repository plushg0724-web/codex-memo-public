{
  "name": "codex-memo",
  "private": true,
  "description": "Codex 메모: strict TypeScript Node backend and Windows Python helper.",
  "scripts": {
    "check": "npm run build && tsc -p jsconfig.json && tsc -p labels/jsconfig.json",
    "test": "python tests/run_all.py",
    "test:core": "python tests/run_all.py --suite core",
    "test:ui": "python tests/run_all.py --suite ui",
    "test:node": "python tests/run_all.py --suite node",
    "build": "tsc -p tsconfig.node.json",
    "check:node": "tsc -p tsconfig.node.json --noEmit",
    "package": "npm run build && python scripts/package-release.py"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  }
}
