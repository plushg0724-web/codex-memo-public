{
  // Node 백엔드(backend.cjs) 검사. 화면 스크립트는 상위 jsconfig.json 이 검사한다.
  "compilerOptions": {
    "target": "es2022",
    "module": "commonjs",
    "lib": ["es2022"],
    "types": ["node"],
    "typeRoots": ["../node_modules/@types"],
    "checkJs": false,   // // @ts-check 가 붙은 파일만 검사 (vendor 원본은 제외)
    "allowJs": true,
    "noEmit": true,
    "strict": false,
    "skipLibCheck": true
  },
  "include": ["backend.cjs", "mica-mcp.cjs", "../types/globals.d.ts"],
  "exclude": ["vendor"]
}
